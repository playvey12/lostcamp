ADMIN_NOTIFY_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=
PREVIEW_IFRAME_MODE=
# Email delivery via Resend (https://resend.com) — replaces the old SMTP setup
# RESEND_API_KEY: create at https://resend.com/api-keys
# MAIL_FROM_EMAIL: sender address; must be on a domain verified at
#   https://resend.com/domains (or use onboarding@resend.dev for testing —
#   that only lets you send to the email you signed up to Resend with)
RESEND_API_KEY=
MAIL_FROM_EMAIL=
# DaData suggestions API (city/street/FIO autocomplete on the checkout page)
# Get a key at https://dadata.ru/profile/#info
DADATA_API_KEY=
# YooKassa (ЮKassa) online payments — https://yookassa.ru/developers
# YOOKASSA_SHOP_ID / YOOKASSA_SECRET_KEY: from your YooKassa merchant
#   dashboard -> Настройки -> Ключи API (use the LIVE secret key once you're
#   ready to accept real payments; there's a separate TEST key for testing)
# PUBLIC_SITE_URL: your site's public https URL, e.g. https://lostcamp.ru
#   (used to send customers back after paying)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PUBLIC_SITE_URL=